<?xml version="1.0" encoding="UTF-8"?>

<!--
  1i 나의 기록 — ListView + 콤보 필터를 날짜 타임라인 + 필터 칩으로 바꿨습니다.

  줄이 어느 날 것인지 셀마다 날짜를 달던 것을, 날짜 머리글 아래로 묶어 한 번만 씁니다.
  탭과 필터는 전부 코드에서 채웁니다 (tabSeg / filterRow).
-->

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.safefood.view.controller.HistoryController">

    <top>
        <fx:include fx:id="nav" source="nav.fxml"/>
    </top>

    <center>
        <ScrollPane fitToWidth="true">
            <VBox alignment="TOP_CENTER" styleClass="screen">
                <padding>
                    <Insets top="8" right="28" bottom="30" left="28"/>
                </padding>

                <VBox maxWidth="760" spacing="16">

                    <HBox spacing="12" alignment="CENTER_LEFT">
                        <Label text="나의 기록" styleClass="page-title"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <HBox fx:id="tabSeg" alignment="CENTER_RIGHT"/>
                    </HBox>

                    <HBox fx:id="filterRow" spacing="6" alignment="CENTER_LEFT"/>

                    <VBox fx:id="timelineBox" spacing="6"/>
                </VBox>
            </VBox>
        </ScrollPane>
    </center>
</BorderPane>
