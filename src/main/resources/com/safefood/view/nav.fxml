<?xml version="1.0" encoding="UTF-8"?>
<!--
  화면 상단 내비게이션 — 화면마다 복사하지 않고 여기 하나만 둡니다.

  예전에는 main·meal·profile·history 네 곳에 같은 블록이 복붙되어 있었습니다. 그래서 '우리 아이 급식'
  버튼을 넣을 때 두 곳만 고쳐져 화면마다 메뉴가 다른 상태가 됐습니다.

  쓰는 쪽:
      <fx:include fx:id="nav" source="nav.fxml"/>
  컨트롤러에서:
      @FXML private NavController navController;   // fx:id + "Controller"
      navController.setActive(NavController.Tab.MEAL);
-->
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>

<HBox xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.safefood.view.controller.NavController"
      spacing="18" alignment="CENTER_LEFT" styleClass="toolbar">

    <HBox spacing="9" alignment="CENTER_LEFT">
        <ImageView fitWidth="34" fitHeight="34" preserveRatio="true" smooth="true">
            <image>
                <Image url="@logo.png"/>
            </image>
        </ImageView>
        <Label text="SafeFood" styleClass="section-title"/>
    </HBox>

    <Region HBox.hgrow="ALWAYS"/>

    <Button fx:id="mainButton" text="추천" styleClass="nav-button" onAction="#handleMain"/>
    <Button fx:id="profileButton" text="내 정보" styleClass="nav-button" onAction="#handleProfile"/>
    <Button fx:id="historyButton" text="기록" styleClass="nav-button" onAction="#handleHistory"/>
    <Button fx:id="mealButton" text="우리 아이 급식" styleClass="nav-button" onAction="#handleMeal"/>
    <Button fx:id="groupButton" text="같이 먹기" styleClass="primary" onAction="#handleGroup"/>
    <Label fx:id="userLabel" text="사용자님" styleClass="sub"/>
    <Button text="로그아웃" styleClass="ghost-quiet" onAction="#handleLogout"/>
</HBox>
