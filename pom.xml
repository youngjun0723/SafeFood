<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <groupId>com.safefood</groupId>
    <artifactId>safefood</artifactId>
    <version>1.0-SNAPSHOT</version>
    <packaging>jar</packaging>

    <name>SafeFood</name>
    <description>알레르기를 고려한 음식 추천 · 그룹 메뉴 결정 애플리케이션</description>

    <properties>
        <!-- JDK 버전을 바꾸려면 이 값만 고치면 됩니다. -->
        <maven.compiler.release>21</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>

        <mysql.connector.version>8.4.0</mysql.connector.version>
        <javafx.version>21.0.4</javafx.version>
        <junit.version>5.10.2</junit.version>
        <exec.plugin.version>3.2.0</exec.plugin.version>
        <javafx.plugin.version>0.0.8</javafx.plugin.version>
        <compiler.plugin.version>3.13.0</compiler.plugin.version>
        <surefire.plugin.version>3.2.5</surefire.plugin.version>
        <shade.plugin.version>3.6.0</shade.plugin.version>

        <!-- java -jar 로 실행할 때의 시작 클래스 (Application을 상속하지 않아야 합니다) -->
        <app.main.class>com.safefood.MainLauncher</app.main.class>
    </properties>

    <dependencies>
        <!-- MySQL JDBC 드라이버. lib/ 폴더에 jar를 직접 넣던 방식을 대체합니다. -->
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <version>${mysql.connector.version}</version>
        </dependency>

        <!-- JavaFX (GUI). 콘솔/웹으로 방향이 바뀌면 이 두 개를 지우면 됩니다. -->
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-controls</artifactId>
            <version>${javafx.version}</version>
        </dependency>
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-fxml</artifactId>
            <version>${javafx.version}</version>
        </dependency>

        <!-- 주소 검색(카카오 우편번호 서비스)은 JavaScript 위젯이라 WebView로 띄웁니다.
             네이티브 엔진(jfxwebkit)이 딸려 와서 실행 JAR이 100MB 가까이 커집니다. -->
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-web</artifactId>
            <version>${javafx.version}</version>
        </dependency>

        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <finalName>safefood</finalName>

        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>${compiler.plugin.version}</version>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>${surefire.plugin.version}</version>
            </plugin>

            <!-- mvn exec:java 로 일반 실행 / -Pwizard 로 Setup Wizard 실행 -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>${exec.plugin.version}</version>
                <configuration>
                    <mainClass>com.safefood.Main</mainClass>
                </configuration>
            </plugin>

            <!-- mvn javafx:run 으로 GUI 실행 (JavaFX 모듈 경로를 플러그인이 알아서 잡아 줍니다).
                 mainClass는 javafx.application.Application을 상속한 클래스여야 합니다. -->
            <plugin>
                <groupId>org.openjfx</groupId>
                <artifactId>javafx-maven-plugin</artifactId>
                <version>${javafx.plugin.version}</version>
                <configuration>
                    <mainClass>com.safefood.view.indexUi</mainClass>
                </configuration>
            </plugin>

            <!-- mvn package → target/safefood.jar 하나에 의존성까지 전부 넣습니다.
                 java -jar target/safefood.jar 로 어디서나 실행됩니다. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>${shade.plugin.version}</version>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>
                        <configuration>
                            <createDependencyReducedPom>false</createDependencyReducedPom>
                            <transformers>
                                <transformer
                                        implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                                    <mainClass>${app.main.class}</mainClass>
                                </transformer>
                                <transformer
                                        implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
                            </transformers>
                            <filters>
                                <filter>
                                    <artifact>*:*</artifact>
                                    <excludes>
                                        <!-- JavaFX jar의 module-info가 섞이면 실행이 막힙니다 -->
                                        <exclude>module-info.class</exclude>
                                        <exclude>META-INF/versions/*/module-info.class</exclude>
                                        <exclude>META-INF/*.SF</exclude>
                                        <exclude>META-INF/*.DSA</exclude>
                                        <exclude>META-INF/*.RSA</exclude>
                                    </excludes>
                                </filter>
                            </filters>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!-- 개발 환경 설정 마법사 (콘솔): mvn compile exec:java -Pwizard -->
        <profile>
            <id>wizard</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.codehaus.mojo</groupId>
                        <artifactId>exec-maven-plugin</artifactId>
                        <configuration>
                            <mainClass>com.safefood.setup.SetupWizard</mainClass>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>

        <!-- 개발 환경 설정 마법사 (JavaFX 창): mvn javafx:run -Pwizard-fx
             하는 일은 위 콘솔판과 같습니다. 화면만 다릅니다. -->
        <profile>
            <id>wizard-fx</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.openjfx</groupId>
                        <artifactId>javafx-maven-plugin</artifactId>
                        <configuration>
                            <mainClass>com.safefood.setup.SetupWizardFx</mainClass>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>

        <profile>
            <id>import-food</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.codehaus.mojo</groupId>
                        <artifactId>exec-maven-plugin</artifactId>
                        <configuration>
                            <mainClass>com.safefood.tool.MenuGenImporter</mainClass>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>

        <!-- 식당·메뉴 기본 데이터 반영: mvn compile exec:java -Pimport-seed -->
        <profile>
            <id>import-seed</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.codehaus.mojo</groupId>
                        <artifactId>exec-maven-plugin</artifactId>
                        <configuration>
                            <mainClass>com.safefood.tool.SeedImporter</mainClass>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>

        <!-- 앱 없이 그룹 추천만 눈으로 확인: mvn compile exec:java -Pprobe-group -->
        <profile>
            <id>probe-group</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.codehaus.mojo</groupId>
                        <artifactId>exec-maven-plugin</artifactId>
                        <configuration>
                            <mainClass>com.safefood.tool.GroupRecommendProbe</mainClass>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>

</project>
