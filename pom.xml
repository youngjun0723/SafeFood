<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <groupId>com.safefood</groupId>
    <artifactId>safefood</artifactId>
    <version>1.0-SNAPSHOT</version>
    <packaging>jar</packaging>

    <name>SafeFood</name>
    <description>알레르기를 고려한 음식 추천 · 그룹 메뉴 결정 애플리케이션</description>

    <properties>
        <!-- JDK 버전을 바꾸려면 이 값만 고치면 됩니다. -->
        <maven.compiler.release>21</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>

        <mysql.connector.version>8.4.0</mysql.connector.version>
        <javafx.version>21.0.4</javafx.version>
        <junit.version>5.10.2</junit.version>
        <exec.plugin.version>3.2.0</exec.plugin.version>
        <javafx.plugin.version>0.0.8</javafx.plugin.version>
        <compiler.plugin.version>3.13.0</compiler.plugin.version>
        <surefire.plugin.version>3.2.5</surefire.plugin.version>
        <jar.plugin.version>3.4.1</jar.plugin.version>
        <dependency.plugin.version>3.7.1</dependency.plugin.version>
        <clean.plugin.version>3.4.0</clean.plugin.version>

        <!-- 실행 파일(exe) 빌드 설정: mvn clean package -Pexe -->
        <app.name>SafeFood</app.name>
        <app.version>1.0</app.version>
        <app.main.class>com.safefood.MainLauncher</app.main.class>
        <!-- 업그레이드 식별자 — 절대 바꾸지 마세요. 바꾸면 기존 설치를 덮어쓰지 못하고 따로 깔립니다. -->
        <app.upgrade.uuid>4BB53F4D-B659-49F4-A2B0-A4B545CA2E9B</app.upgrade.uuid>
    </properties>

    <dependencies>
        <!-- MySQL JDBC 드라이버. lib/ 폴더에 jar를 직접 넣던 방식을 대체합니다. -->
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <version>${mysql.connector.version}</version>
        </dependency>

        <!-- JavaFX (GUI). 콘솔/웹으로 방향이 바뀌면 이 두 개를 지우면 됩니다. -->
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-controls</artifactId>
            <version>${javafx.version}</version>
        </dependency>
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-fxml</artifactId>
            <version>${javafx.version}</version>
        </dependency>

        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <finalName>safefood</finalName>

        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>${compiler.plugin.version}</version>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>${surefire.plugin.version}</version>
            </plugin>

            <!-- mvn exec:java 로 일반 실행 / -Pwizard 로 Setup Wizard 실행 -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>${exec.plugin.version}</version>
                <configuration>
                    <mainClass>com.safefood.Main</mainClass>
                </configuration>
            </plugin>

            <!-- mvn javafx:run 으로 GUI 실행 (JavaFX 모듈 경로를 플러그인이 알아서 잡아 줍니다).
                 mainClass는 javafx.application.Application을 상속한 클래스여야 합니다. -->
            <plugin>
                <groupId>org.openjfx</groupId>
                <artifactId>javafx-maven-plugin</artifactId>
                <version>${javafx.plugin.version}</version>
                <configuration>
                    <mainClass>com.safefood.view.indexUi</mainClass>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!-- 개발 환경 설정 마법사 (콘솔): mvn compile exec:java -Pwizard -->
        <profile>
            <id>wizard</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.codehaus.mojo</groupId>
                        <artifactId>exec-maven-plugin</artifactId>
                        <configuration>
                            <mainClass>com.safefood.setup.SetupWizard</mainClass>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>

        <!-- 개발 환경 설정 마법사 (JavaFX 창): mvn javafx:run -Pwizard-fx
             하는 일은 위 콘솔판과 같습니다. 화면만 다릅니다. -->
        <profile>
            <id>wizard-fx</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.openjfx</groupId>
                        <artifactId>javafx-maven-plugin</artifactId>
                        <configuration>
                            <mainClass>com.safefood.setup.SetupWizardFx</mainClass>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>

        <!-- 실행 파일(exe) 만들기: mvn clean package -Pexe
             결과물은 target/dist/SafeFood/ 폴더이며 SafeFood.exe와 전용 런타임이 함께 들어갑니다.
             자세한 사용법·주의사항은 docs/Packaging.md를 보세요. -->
        <profile>
            <id>exe</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-jar-plugin</artifactId>
                        <version>${jar.plugin.version}</version>
                        <configuration>
                            <outputDirectory>${project.build.directory}/app</outputDirectory>
                        </configuration>
                    </plugin>

                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-clean-plugin</artifactId>
                        <version>${clean.plugin.version}</version>
                        <executions>
                            <execution>
                                <id>remove-previous-dist</id>
                                <phase>prepare-package</phase>
                                <goals>
                                    <goal>clean</goal>
                                </goals>
                                <configuration>
                                    <excludeDefaultDirectories>true</excludeDefaultDirectories>
                                    <filesets>
                                        <fileset>
                                            <directory>${project.build.directory}/dist</directory>
                                        </fileset>
                                        <fileset>
                                            <directory>${project.build.directory}/app</directory>
                                        </fileset>
                                    </filesets>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>

                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-dependency-plugin</artifactId>
                        <version>${dependency.plugin.version}</version>
                        <executions>
                            <execution>
                                <id>copy-runtime-libs</id>
                                <phase>package</phase>
                                <goals>
                                    <goal>copy-dependencies</goal>
                                </goals>
                                <configuration>
                                    <outputDirectory>${project.build.directory}/app</outputDirectory>
                                    <includeScope>runtime</includeScope>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>

                    <plugin>
                        <groupId>org.codehaus.mojo</groupId>
                        <artifactId>exec-maven-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>jpackage</id>
                                <phase>package</phase>
                                <goals>
                                    <goal>exec</goal>
                                </goals>
                                <configuration>
                                    <executable>${java.home}/bin/jpackage</executable>
                                    <arguments>
                                        <argument>--type</argument>
                                        <argument>app-image</argument>
                                        <argument>--name</argument>
                                        <argument>${app.name}</argument>
                                        <argument>--app-version</argument>
                                        <argument>${app.version}</argument>
                                        <argument>--vendor</argument>
                                        <argument>SafeFood Team</argument>
                                        <argument>--input</argument>
                                        <argument>${project.build.directory}/app</argument>
                                        <argument>--main-jar</argument>
                                        <argument>${project.build.finalName}.jar</argument>
                                        <argument>--main-class</argument>
                                        <argument>${app.main.class}</argument>
                                        <argument>--icon</argument>
                                        <argument>${project.basedir}/data/public/icon/safefood.ico</argument>
                                        <argument>--dest</argument>
                                        <argument>${project.build.directory}/dist</argument>
                                        <argument>--java-options</argument>
                                        <argument>-Dfile.encoding=UTF-8</argument>
                                        <argument>--java-options</argument>
                                        <argument>-Dstdout.encoding=UTF-8</argument>
                                        <argument>--java-options</argument>
                                        <argument>-Dstderr.encoding=UTF-8</argument>
                                    </arguments>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>

                </plugins>
            </build>
        </profile>

        <!-- 설치 파일 만들기: mvn clean package -Pexe,installer
             exe 프로파일이 만든 폴더를 그대로 감싸 설치 마법사를 만듭니다 (WiX Toolset v3 필요).
             자세한 내용은 docs/Development.md를 보세요. -->
        <profile>
            <id>installer</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.codehaus.mojo</groupId>
                        <artifactId>exec-maven-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>build-installer</id>
                                <phase>package</phase>
                                <goals>
                                    <goal>exec</goal>
                                </goals>
                                <configuration>
                                    <executable>${java.home}/bin/jpackage</executable>
                                    <!-- jpackage는 candle.exe·light.exe를 PATH에서 찾습니다.
                                         WiX 설치 관리자는 PATH를 건드리지 않고 WIX 변수만 남깁니다. -->
                                    <environmentVariables>
                                        <PATH>${env.PATH};${env.WIX}bin</PATH>
                                    </environmentVariables>
                                    <arguments>
                                        <argument>--type</argument>
                                        <argument>exe</argument>
                                        <argument>--app-image</argument>
                                        <argument>${project.build.directory}/dist/${app.name}</argument>
                                        <argument>--name</argument>
                                        <argument>${app.name}</argument>
                                        <argument>--app-version</argument>
                                        <argument>${app.version}</argument>
                                        <argument>--vendor</argument>
                                        <argument>SafeFood Team</argument>
                                        <!-- MSI는 코드 페이지 1252라 한글을 넣으면 light.exe가 311로 실패합니다. -->
                                        <argument>--description</argument>
                                        <argument>Allergy-aware food recommendation</argument>
                                        <argument>--dest</argument>
                                        <argument>${project.build.directory}/installer</argument>
                                        <argument>--win-upgrade-uuid</argument>
                                        <argument>${app.upgrade.uuid}</argument>
                                        <argument>--win-per-user-install</argument>
                                        <argument>--win-dir-chooser</argument>
                                        <argument>--win-menu</argument>
                                        <argument>--win-menu-group</argument>
                                        <argument>${app.name}</argument>
                                        <argument>--win-shortcut</argument>
                                        <argument>--win-shortcut-prompt</argument>
                                    </arguments>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>

        <profile>
            <id>import-food</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.codehaus.mojo</groupId>
                        <artifactId>exec-maven-plugin</artifactId>
                        <configuration>
                            <mainClass>com.safefood.tool.MenuGenImporter</mainClass>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>

</project>
