# SafeFood 설정 파일 예시 (이 파일은 커밋해도 됩니다)
#
# 같은 폴더(프로젝트 루트)에 config.properties로 복사한 뒤 본인 환경에 맞게 채우거나,
# Setup Wizard를 실행하면 자동으로 만들어집니다: mvn compile exec:java -Pwizard
# (창으로 된 화면: mvn javafx:run -Pwizard-fx)

db.url=jdbc:mysql://localhost:3306/safefood?serverTimezone=Asia/Seoul&characterEncoding=UTF-8&allowPublicKeyRetrieval=true&useSSL=false
db.user=
db.password=

# 카카오 지도 — 키가 두 개이고, 서로를 대신하지 못합니다.
# (카카오 개발자 콘솔 › 내 애플리케이션 › 앱 키 에 나란히 있습니다)
#
#   kakao.js.key  = JavaScript 키 — 맛집 상세의 지도를 그립니다.
#                   비우면 지도 자리에 안내 문구가 뜹니다.
#   map.api.key   = REST API 키   — 위치 등록에서 '주소 → 좌표'를 찾습니다.
#                   비우면 좌표 없이 주소만 등록됩니다 (거리 계산에서만 빠집니다).
#
# 주소 검색 자체는 카카오 우편번호 서비스라 키가 없어도 됩니다.
kakao.js.key=
map.api.key=

# 나이스(NEIS) 교육정보 개방 포털 인증키 — '우리 아이 급식'에서만 씁니다.
# open.neis.go.kr 에서 발급받아 채우면 학교 검색과 급식 조회가 열립니다.
neis.api.key=

menugen.api.key=

socket.host=localhost
socket.port=5000
